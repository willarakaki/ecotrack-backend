# ==========================================
# ECOTRACK GLOBAL COMPOSE - ENVIRONMENT CONFIG
# ==========================================

# 1. Google Gemini API (Inferencia de IA e Visao Computacional)
GOOGLE_API_KEY=sua_chave_google_api_aqui

# 2. LangSmith (Observabilidade e Rastreamento)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=sua_chave_langsmith_aqui
LANGCHAIN_PROJECT=ecotrack-ai

# 3. Local Ollama (Roteamento para host local a partir do Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 4. Oracle XE Database
ORACLE_PASSWORD=secret_local_pass
APP_USER=ecotrack_admin
APP_PASSWORD=secret_local_pass
