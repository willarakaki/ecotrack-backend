# ==========================================
# ECOTRACK AI SERVICE - ENVIRONMENT CONFIG
# ==========================================

# 1. Google Gemini API (VLM Auditor & Copilot LLM)
# Obtenha em: https://aistudio.google.com/
GOOGLE_API_KEY=sua_chave_google_api_aqui

# 2. Local Ollama (Qwen 2.5 7B Neural Guardrail & Llava Gatekeeper)
# Padrao local: http://localhost:11434 (ou http://host.docker.internal:11434 no Docker)
OLLAMA_BASE_URL=http://localhost:11434

# 3. LangSmith (Observabilidade e Tracing de Agentes)
# Obtenha em: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=sua_chave_langsmith_aqui
LANGCHAIN_PROJECT=ecotrack-ai

# 4. Apache Kafka (Mensageria e Eventos ESG)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ai-validation-group
KAFKA_TOPIC_EVIDENCE=ia-evidence-requests-topic
KAFKA_TOPIC_RESULTS=ia-evidence-results-topic

# 5. Hugging Face (Opcional - caso utilize modelos proprietarios do HF Hub)
HF_TOKEN=seu_token_huggingface_aqui
