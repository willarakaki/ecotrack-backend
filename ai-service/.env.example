# API Keys (NUNCA comite o .env real, apenas este .example)
GEMINI_API_KEY=sua_chave_gemini_aqui

# LangSmith (Observabilidade para IA)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=sua_chave_langsmith_aqui
