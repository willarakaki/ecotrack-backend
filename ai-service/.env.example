# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ai-validation-group
KAFKA_TOPIC_EVIDENCE=ia-evidence-requests-topic
KAFKA_TOPIC_RESULTS=ia-evidence-results-topic
